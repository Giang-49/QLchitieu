generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            BigInt    @id @default(autoincrement())
  email         String    @unique @db.VarChar(191)
  password_hash String    @db.VarChar(255)
  name          String    @db.VarChar(100)
  created_at    DateTime  @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @updatedAt @db.Timestamp(0)

  wallets      Wallet[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  debts        Debt[]

  @@map("users")
}

model Wallet {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  name       String   @db.VarChar(100)
  balance    Decimal  @default(0.00) @db.Decimal(15, 2)
  type       String   @default("cash") @db.VarChar(20)
  currency   String   @default("VND") @db.VarChar(10)
  created_at DateTime @default(now()) @db.Timestamp(0)

  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  debts         Debt[]
  debt_payments DebtPayment[]

  @@map("wallets")
}

model Category {
  id        BigInt   @id @default(autoincrement())
  user_id   BigInt
  name      String   @db.VarChar(100)
  icon      String?  @db.VarChar(50)
  color     String?  @default("#1F4E79") @db.VarChar(20)
  type      String   @db.VarChar(20)
  parent_id BigInt?
  is_active Boolean  @default(true)

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryToCategory", fields: [parent_id], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryToCategory")
  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

model Transaction {
  id               BigInt   @id @default(autoincrement())
  user_id          BigInt
  wallet_id        BigInt
  category_id      BigInt
  type             String   @db.VarChar(20)
  amount           Decimal  @db.Decimal(15, 2)
  note             String?  @db.Text
  image_url        String?  @db.VarChar(500)
  transaction_date DateTime @db.DateTime(0)
  created_at       DateTime @default(now()) @db.Timestamp(0)

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  wallet   Wallet   @relation(fields: [wallet_id], references: [id], onDelete: Restrict)
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@index([user_id, transaction_date(sort: Desc)], name: "idx_transactions_user_date")
  @@index([category_id], name: "idx_transactions_category")
  @@index([wallet_id], name: "idx_transactions_wallet")
  @@map("transactions")
}

model Budget {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt
  category_id BigInt
  amount      Decimal  @db.Decimal(15, 2)
  month       Int
  year        Int
  created_at  DateTime @default(now()) @db.Timestamp(0)

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id, month, year], name: "uk_user_category_month_year")
  @@index([user_id, month, year], name: "idx_budgets_user_period")
  @@map("budgets")
}

model Debt {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt
  wallet_id   BigInt
  type        String    @db.VarChar(20)
  person_name String    @db.VarChar(100)
  amount      Decimal   @db.Decimal(15, 2)
  remaining   Decimal   @db.Decimal(15, 2)
  due_date    DateTime? @db.Date
  status      String    @default("unpaid") @db.VarChar(20)
  note        String?   @db.Text
  created_at  DateTime  @default(now()) @db.Timestamp(0)

  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  wallet        Wallet        @relation(fields: [wallet_id], references: [id], onDelete: Restrict)
  debt_payments DebtPayment[]

  @@index([user_id, status], name: "idx_debts_user_status")
  @@index([due_date], name: "idx_debts_due_date")
  @@map("debts")
}

model DebtPayment {
  id        BigInt   @id @default(autoincrement())
  debt_id   BigInt
  wallet_id BigInt
  amount    Decimal  @db.Decimal(15, 2)
  note      String?  @db.VarChar(255)
  paid_at   DateTime @default(now()) @db.DateTime(0)

  debt   Debt   @relation(fields: [debt_id], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [wallet_id], references: [id], onDelete: Restrict)

  @@map("debt_payments")
}