generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Đổi thành "postgresql" nếu bạn đang dùng Postgres
  url      = env("DATABASE_URL")
}

model User {
  id            BigInt        @id @default(autoincrement())
  email         String        @unique @db.VarChar(191)
  password_hash String        @db.VarChar(255)
  name          String        @db.VarChar(100)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  wallets      Wallet[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  budgetAlerts BudgetAlert[]
  debts        Debt[]

  @@map("users")
}

model Wallet {
  id            BigInt        @id @default(autoincrement())
  user_id       BigInt
  name          String        @db.VarChar(100)
  balance       Decimal       @default(0.00) @db.Decimal(15, 2)
  type          String        @default("cash") @db.VarChar(20) // cash | bank | ewallet
  currency      String        @default("VND") @db.VarChar(10)
  created_at    DateTime      @default(now())

  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  debts         Debt[]
  debt_payments DebtPayment[]

  @@map("wallets")
}

model Category {
  id           BigInt        @id @default(autoincrement())
  user_id      BigInt
  name         String        @db.VarChar(100)
  icon         String?       @db.VarChar(50)
  color        String?       @default("#1F4E79") @db.VarChar(20)
  type         String        @db.VarChar(20) // income | expense
  parent_id    BigInt?
  is_active    Boolean       @default(true)

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets      Budget[]
  budgetAlerts BudgetAlert[]

  @@map("categories")
}

model Transaction {
  id               BigInt   @id @default(autoincrement())
  user_id          BigInt
  wallet_id        BigInt
  category_id      BigInt
  type             String   @db.VarChar(20) // income | expense
  amount           Decimal  @db.Decimal(15, 2)
  note             String?  @db.Text
  image_url        String?  @db.VarChar(500)
  transaction_date DateTime
  created_at       DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  wallet   Wallet   @relation(fields: [wallet_id], references: [id], onDelete: Restrict)
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)

  @@index([user_id, transaction_date], map: "idx_transactions_user_date")
  @@index([category_id], map: "idx_transactions_category")
  @@index([wallet_id], map: "idx_transactions_wallet")
  @@map("transactions")
}

model Budget {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt
  category_id BigInt
  amount      Decimal  @db.Decimal(15, 2)
  month       Int
  year        Int
  created_at  DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id, month, year], map: "uk_user_category_month_year")
  @@index([user_id, month, year], map: "idx_budgets_user_period")
  @@map("budgets")
}

model BudgetAlert {
  user_id     BigInt
  category_id BigInt
  year        Int
  month       Int
  threshold   Int      @db.UnsignedTinyInt
  percentage  Decimal  @db.Decimal(22, 2)
  created_at  DateTime @default(now()) @db.DateTime(3)

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_budget_alert_user")
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade, map: "fk_budget_alert_category")

  @@id([user_id, category_id, year, month, threshold])
  @@index([user_id, year, month], map: "idx_budget_alert_user_period")
  @@map("budget_alerts")
}

model Debt {
  id          BigInt        @id @default(autoincrement())
  user_id     BigInt
  wallet_id   BigInt
  type        String        @db.VarChar(20) // lend | borrow
  person_name String        @db.VarChar(100)
  amount      Decimal       @db.Decimal(15, 2)
  remaining   Decimal       @db.Decimal(15, 2)
  due_date    DateTime?     @db.Date
  status      String        @default("unpaid") @db.VarChar(20) // unpaid | partial | completed | overdue
  note        String?       @db.Text
  created_at  DateTime      @default(now())

  user     User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  wallet   Wallet        @relation(fields: [wallet_id], references: [id], onDelete: Restrict)
  payments DebtPayment[]

  @@index([user_id, status], map: "idx_debts_user_status")
  @@index([due_date], map: "idx_debts_due_date")
  @@map("debts")
}

model DebtPayment {
  id        BigInt   @id @default(autoincrement())
  debt_id   BigInt
  wallet_id BigInt
  amount    Decimal  @db.Decimal(15, 2)
  note      String?  @db.VarChar(255)
  paid_at   DateTime @default(now())

  debt   Debt   @relation(fields: [debt_id], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [wallet_id], references: [id], onDelete: Restrict)

  @@map("debt_payments")
}
