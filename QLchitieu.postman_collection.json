{
  "info": {
    "name": "QLchitieu API Collection",
    "description": "Bộ sưu tập API hoàn chỉnh cho Hệ thống Quản lý Chi tiêu Cá nhân (QLchitieu)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Đăng ký tài khoản",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('token', res.data.access_token);",
                  "    console.log('Saved token successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@qlchitieu.vn\",\n  \"password\": \"123456\",\n  \"name\": \"Nguyễn Văn A\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Đăng nhập",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "    pm.collectionVariables.set('token', res.data.access_token);",
                  "    console.log('Saved token successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@qlchitieu.vn\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Lấy thông tin cá nhân (Profile)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Wallets (Quản lý Ví)",
      "item": [
        {
          "name": "2.1 Lấy danh sách ví & tổng số dư",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["wallets"]
            }
          }
        },
        {
          "name": "2.2 Tạo ví mới",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tài khoản MB Bank\",\n  \"type\": \"bank\",\n  \"balance\": 10000000,\n  \"currency\": \"VND\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["wallets"]
            }
          }
        },
        {
          "name": "2.3 Xem chi tiết ví",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/1",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "1"]
            }
          }
        },
        {
          "name": "2.4 Cập nhật ví",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MB Bank Tiết Kiệm\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/1",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "1"]
            }
          }
        },
        {
          "name": "2.5 Xóa ví",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/1",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Categories (Danh mục)",
      "item": [
        {
          "name": "3.1 Lấy cây danh mục",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "3.2 Tạo mới danh mục",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cà phê & Đồ uống\",\n  \"icon\": \"coffee\",\n  \"color\": \"#E67E22\",\n  \"type\": \"expense\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "3.3 Xóa / Ẩn danh mục (kèm replace_id)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/1?replace_id=2",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "1"],
              "query": [
                { "key": "replace_id", "value": "2" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Transactions (Giao dịch thu chi)",
      "item": [
        {
          "name": "4.1 Thêm giao dịch chi tiêu",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": 1,\n  \"category_id\": 1,\n  \"type\": \"expense\",\n  \"amount\": 80000,\n  \"note\": \"Ăn trưa bún bò\",\n  \"transaction_date\": \"2026-11-18T12:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        },
        {
          "name": "4.2 Danh sách giao dịch (kèm lọc & phân trang)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions?page=1&limit=10&type=expense",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "type", "value": "expense" }
              ]
            }
          }
        },
        {
          "name": "4.3 Xem chi tiết 1 giao dịch",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions/1",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "1"]
            }
          }
        },
        {
          "name": "4.4 Cập nhật giao dịch",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 95000,\n  \"note\": \"Ăn trưa bún bò thêm chả\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/1",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "1"]
            }
          }
        },
        {
          "name": "4.5 Xóa giao dịch (Hoàn tiền ví)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions/1",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Budgets (Hạn mức ngân sách)",
      "item": [
        {
          "name": "5.1 Thiết lập hạn mức ngân sách tháng",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"amount\": 3000000,\n  \"month\": 11,\n  \"year\": 2026\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/budgets",
              "host": ["{{baseUrl}}"],
              "path": ["budgets"]
            }
          }
        },
        {
          "name": "5.2 Xem tiến độ ngân sách tháng",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/budgets?month=11&year=2026",
              "host": ["{{baseUrl}}"],
              "path": ["budgets"],
              "query": [
                { "key": "month", "value": "11" },
                { "key": "year", "value": "2026" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Debts & Payments (Sổ nợ)",
      "item": [
        {
          "name": "6.1 Tạo khoản cho vay",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": 1,\n  \"type\": \"lend\",\n  \"person_name\": \"Nguyễn Văn Hùng\",\n  \"amount\": 2000000,\n  \"due_date\": \"2026-11-30\",\n  \"note\": \"Cho mượn tiền mua đồ\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/debts",
              "host": ["{{baseUrl}}"],
              "path": ["debts"]
            }
          }
        },
        {
          "name": "6.2 Danh sách khoản nợ",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/debts",
              "host": ["{{baseUrl}}"],
              "path": ["debts"]
            }
          }
        },
        {
          "name": "6.3 Ghi nhận trả nợ",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": 1,\n  \"amount\": 1000000,\n  \"note\": \"Trả đợt 1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/debts/1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["debts", "1", "payments"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Reports & Notifications",
      "item": [
        {
          "name": "7.1 Báo cáo tỷ trọng chi tiêu (Pie Chart)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/category-pie",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "category-pie"]
            }
          }
        },
        {
          "name": "7.2 Báo cáo Thu vs Chi 12 tháng",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/income-vs-expense?year=2026",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "income-vs-expense"],
              "query": [
                { "key": "year", "value": "2026" }
              ]
            }
          }
        },
        {
          "name": "7.3 Xuất file Excel giao dịch",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/export-excel",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "export-excel"]
            }
          }
        },
        {
          "name": "7.4 Danh sách thông báo & cảnh báo",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            }
          }
        }
      ]
    }
  ]
}
